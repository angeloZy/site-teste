<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NORMA Engenharia — Segurança do Trabalho, Consultoria e Tecnologia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --azul-profundo:#132840;
    --azul-profundo-2:#0d1e30;
    --azul-claro:#5B9BD5;
    --azul-claro-2:#3D7DC9;
    --azul-vidro:#EAF3FB;
    --azul-vidro-2:#F5FAFD;
    --cinza-escuro:#212832;
    --cinza-medio:#5C6773;
    --cinza-suave:#8B96A3;
    --cinza-claro:#F3F5F7;
    --cinza-borda:#DFE5EA;
    --branco:#FFFFFF;
    --radius:4px;
    --maxw:1220px;
    --display:'Big Shoulders Display', sans-serif;
    --body:'Inter', sans-serif;
    --mono:'IBM Plex Mono', monospace;
    --shadow-sm:0 1px 2px rgba(19,40,64,0.06);
    --shadow-md:0 8px 24px rgba(19,40,64,0.10);
    --shadow-lg:0 20px 48px rgba(19,40,64,0.16);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--body);
    color:var(--cinza-escuro);
    background:var(--branco);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block;max-width:100%;}
  a{color:inherit;text-decoration:none;}
  ul{list-style:none;}
  button{font-family:inherit;cursor:pointer;border:none;background:none;}
  input,textarea,select{font-family:inherit;font-size:1rem;}

  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 32px;}

  h1,h2,h3,h4{font-family:var(--display);font-weight:700;letter-spacing:0.01em;line-height:1.05;color:var(--azul-profundo);}

  .eyebrow{
    font-family:var(--mono);
    font-size:0.76rem;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--azul-claro-2);
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:16px;
    font-weight:500;
  }
  .eyebrow::before{
    content:"";
    width:22px;height:1px;
    background:var(--azul-claro-2);
    display:inline-block;
  }

  /* Blueprint corner-bracket signature */
  .blueprint{
    position:relative;
    border:1px solid var(--cinza-borda);
  }
  .blueprint::before,
  .blueprint::after,
  .blueprint > .bp-tr,
  .blueprint > .bp-bl{
    content:"";
    position:absolute;
    width:14px;height:14px;
    border:2px solid var(--azul-claro);
    pointer-events:none;
  }
  .blueprint::before{ top:-1px;left:-1px;border-right:none;border-bottom:none; }
  .blueprint::after{ bottom:-1px;right:-1px;border-left:none;border-top:none; }
  .blueprint .bp-tr{ top:-1px;right:-1px;border-left:none;border-bottom:none; }
  .blueprint .bp-bl{ bottom:-1px;left:-1px;border-right:none;border-top:none; }

  .btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:14px 26px;
    font-weight:600;
    font-size:0.95rem;
    border-radius:var(--radius);
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease;
    white-space:nowrap;
  }
  .btn-primary{
    background:var(--azul-claro-2);
    color:#fff;
    box-shadow:var(--shadow-sm);
  }
  .btn-primary:hover{background:var(--azul-profundo);transform:translateY(-2px);box-shadow:var(--shadow-md);}
  .btn-ghost{
    background:transparent;
    color:var(--azul-profundo);
    border:1.5px solid var(--cinza-borda);
  }
  .btn-ghost:hover{border-color:var(--azul-claro-2);color:var(--azul-claro-2);transform:translateY(-2px);}
  .btn-light{
    background:#fff;
    color:var(--azul-profundo);
  }
  .btn-light:hover{background:var(--azul-vidro);transform:translateY(-2px);}

  /* ---------- HEADER ---------- */
  header{
    position:sticky;top:0;z-index:100;
    background:rgba(255,255,255,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--cinza-borda);
  }
  .nav{
    display:flex;align-items:center;justify-content:space-between;
    height:78px;
  }
  .logo{
    display:flex;align-items:center;gap:10px;
    font-family:var(--display);font-weight:800;font-size:1.5rem;
    color:var(--azul-profundo);
    letter-spacing:0.01em;
  }
  .logo .dot{color:var(--azul-claro-2);}
  .logo-mark{
    width:34px;height:34px;
    border:2px solid var(--azul-profundo);
    border-radius:3px;
    display:flex;align-items:center;justify-content:center;
    position:relative;
  }
  .logo-mark::after{
    content:"";
    width:8px;height:8px;
    background:var(--azul-claro-2);
  }
  .nav-links{display:flex;align-items:center;gap:36px;}
  .nav-links a{
    font-size:0.94rem;font-weight:500;color:var(--cinza-medio);
    position:relative;padding:4px 0;
    transition:color .15s ease;
  }
  .nav-links a:hover{color:var(--azul-profundo);}
  .nav-links a::after{
    content:"";position:absolute;left:0;bottom:-2px;width:0;height:2px;
    background:var(--azul-claro-2);transition:width .2s ease;
  }
  .nav-links a:hover::after{width:100%;}
  .nav-right{display:flex;align-items:center;gap:22px;}
  .burger{display:none;flex-direction:column;gap:5px;padding:6px;}
  .burger span{width:24px;height:2px;background:var(--azul-profundo);display:block;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    background:var(--azul-profundo);
    background-image:
      linear-gradient(180deg, rgba(19,40,64,0.97), rgba(13,30,48,0.99)),
      repeating-linear-gradient(0deg, rgba(91,155,213,0.07) 0px, rgba(91,155,213,0.07) 1px, transparent 1px, transparent 48px),
      repeating-linear-gradient(90deg, rgba(91,155,213,0.07) 0px, rgba(91,155,213,0.07) 1px, transparent 1px, transparent 48px);
    color:#fff;
    overflow:hidden;
    padding:96px 0 88px;
  }
  .hero .wrap{
    display:grid;
    grid-template-columns:1.05fr 0.95fr;
    gap:56px;
    align-items:center;
    position:relative;
    z-index:2;
  }
  .hero .eyebrow{color:var(--azul-claro);}
  .hero .eyebrow::before{background:var(--azul-claro);}
  .hero h1{
    color:#fff;
    font-size:clamp(2.5rem, 4.2vw, 3.6rem);
    margin-bottom:22px;
  }
  .hero h1 em{
    font-style:normal;
    color:var(--azul-claro);
  }
  .hero p.lead{
    font-size:1.12rem;
    color:#C9D6E3;
    max-width:520px;
    margin-bottom:34px;
    font-weight:400;
  }
  .hero-ctas{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:44px;}
  .compliance-bar{
    display:flex;align-items:center;flex-wrap:wrap;gap:14px;
    padding-top:26px;
    border-top:1px solid rgba(255,255,255,0.14);
  }
  .compliance-bar .cb-label{
    font-family:var(--mono);font-size:0.72rem;letter-spacing:0.1em;
    color:#8DA3B8;text-transform:uppercase;margin-right:4px;
  }
  .norm-tag{
    font-family:var(--mono);font-size:0.78rem;font-weight:500;
    color:#fff;
    border:1px solid rgba(91,155,213,0.5);
    padding:5px 11px;border-radius:2px;
    background:rgba(91,155,213,0.08);
  }
  .norm-tag-link{cursor:pointer;transition:background .15s ease, border-color .15s ease;}
  .norm-tag-link:hover{background:var(--azul-claro-2);border-color:var(--azul-claro-2);}

  /* Hero visual: blueprint illustration */
  .hero-visual{position:relative;}
  .hero-visual svg{width:100%;height:auto;}
  .scanline{
    animation:scan 4.5s linear infinite;
  }
  @keyframes scan{
    0%{transform:translateY(0);opacity:0;}
    10%{opacity:0.8;}
    90%{opacity:0.8;}
    100%{transform:translateY(330px);opacity:0;}
  }
  .pulse-dot{ animation:pulse 2.4s ease-in-out infinite; transform-origin:center; }
  .pulse-dot.d2{ animation-delay:.6s; }
  .pulse-dot.d3{ animation-delay:1.2s; }
  @keyframes pulse{
    0%,100%{opacity:0.4;r:4;}
    50%{opacity:1;r:6;}
  }

  @media (prefers-reduced-motion: reduce){
    .scanline, .pulse-dot{animation:none;}
  }

  /* ---------- SECTION SHELL ---------- */
  section{padding:104px 0;}
  .section-head{max-width:640px;margin-bottom:56px;}
  .section-head.center{margin-left:auto;margin-right:auto;text-align:center;}
  .section-head h2{font-size:clamp(1.9rem,3vw,2.6rem);margin-bottom:16px;}
  .section-head p{color:var(--cinza-medio);font-size:1.06rem;}
  .bg-alt{background:var(--cinza-claro);}

  /* ---------- SOBRE ---------- */
  .sobre{
    display:grid;
    grid-template-columns:0.92fr 1.08fr;
    gap:64px;
    align-items:center;
  }
  .sobre-visual{
    position:relative;
    padding:28px;
  }
  .sobre-stats{
    display:grid;grid-template-columns:1fr 1fr;gap:1px;
    background:var(--cinza-borda);
    border:1px solid var(--cinza-borda);
  }
  .stat{background:#fff;padding:26px 22px;}
  .stat .num{font-family:var(--display);font-weight:800;font-size:2.3rem;color:var(--azul-claro-2);line-height:1;}
  .stat .lbl{font-family:var(--mono);font-size:0.72rem;letter-spacing:0.06em;color:var(--cinza-medio);text-transform:uppercase;margin-top:8px;}

  .sobre-text h2{margin-bottom:20px;}
  .sobre-text p{color:var(--cinza-medio);margin-bottom:18px;font-size:1.03rem;}
  .pilar-row{display:flex;gap:28px;margin-top:28px;flex-wrap:wrap;}
  .pilar{display:flex;align-items:center;gap:10px;font-weight:600;font-size:0.95rem;color:var(--azul-profundo);}
  .pilar svg{width:20px;height:20px;color:var(--azul-claro-2);flex-shrink:0;}

  /* ---------- SERVICES ---------- */
  .servicos-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:28px;
  }
  .servico-card{
    position:relative;
    background:#fff;
    padding:34px 30px 30px;
    transition:transform .2s ease, box-shadow .2s ease;
  }
  .servico-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);}
  .servico-icon{
    width:52px;height:52px;
    border-radius:var(--radius);
    background:var(--azul-vidro);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:22px;
  }
  .servico-icon svg{width:26px;height:26px;color:var(--azul-claro-2);}
  .servico-card h3{font-size:1.28rem;margin-bottom:6px;}
  .servico-tag{font-family:var(--mono);font-size:0.7rem;color:var(--cinza-suave);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:16px;display:block;}
  .servico-card ul{display:flex;flex-direction:column;gap:11px;margin-top:6px;}
  .servico-card li{
    font-size:0.94rem;color:var(--cinza-medio);
    display:flex;gap:10px;align-items:flex-start;
    line-height:1.45;
  }
  .servico-card li svg{width:15px;height:15px;color:var(--azul-claro-2);flex-shrink:0;margin-top:3px;}
  .servico-card li strong{color:var(--azul-profundo);font-weight:600;}

  .servico-card-featured{
    background:var(--azul-profundo);
    border-color:var(--azul-profundo);
  }
  .servico-card-featured h3, .servico-card-featured .servico-tag{color:#fff;}
  .servico-card-featured .servico-tag{color:var(--azul-claro);}
  .servico-card-featured li{color:#B9C9D8;}
  .servico-card-featured li strong{color:#fff;}
  .servico-card-featured li svg{color:var(--azul-claro);}
  .servico-icon-dark{background:rgba(91,155,213,0.16);}
  .servico-icon-dark svg{color:var(--azul-claro);}
  .servico-ribbon{
    position:absolute;top:18px;right:18px;
    font-family:var(--mono);font-size:0.66rem;letter-spacing:0.06em;text-transform:uppercase;
    color:var(--azul-profundo);background:var(--azul-claro);
    padding:5px 10px;border-radius:20px;font-weight:600;
  }
  .servicos-note{
    max-width:760px;margin:40px auto 0;text-align:center;
    font-size:0.98rem;color:var(--cinza-medio);line-height:1.6;
  }
  .servicos-note strong{color:var(--azul-profundo);}

  /* ---------- DIFERENCIAIS ---------- */
  .dif-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:1px;
    background:var(--cinza-borda);
    border:1px solid var(--cinza-borda);
  }
  .dif-card{
    background:var(--azul-profundo);
    color:#fff;
    padding:38px 28px;
    position:relative;
  }
  .dif-card .dif-num{
    font-family:var(--mono);font-size:0.78rem;color:var(--azul-claro);
    margin-bottom:22px;display:block;
  }
  .dif-icon{width:38px;height:38px;color:var(--azul-claro);margin-bottom:18px;}
  .dif-card h3{color:#fff;font-size:1.12rem;margin-bottom:10px;font-family:var(--body);font-weight:700;letter-spacing:0;}
  .dif-card p{color:#AFC2D4;font-size:0.9rem;line-height:1.55;}

  /* ---------- CONTATO ---------- */
  .contato-grid{
    display:grid;
    grid-template-columns:1fr 1.15fr;
    gap:0;
    border:1px solid var(--cinza-borda);
  }
  .contato-info{
    background:var(--azul-profundo);
    color:#fff;
    padding:52px 44px;
  }
  .contato-info h2{color:#fff;font-size:1.9rem;margin-bottom:14px;}
  .contato-info > p{color:#B9C9D8;margin-bottom:36px;font-size:0.98rem;}
  .info-item{display:flex;gap:16px;margin-bottom:26px;align-items:flex-start;}
  .info-item svg{width:20px;height:20px;color:var(--azul-claro);flex-shrink:0;margin-top:2px;}
  .info-item .lbl{font-family:var(--mono);font-size:0.68rem;letter-spacing:0.08em;color:#8DA3B8;text-transform:uppercase;margin-bottom:3px;}
  .info-item .val{font-size:0.98rem;font-weight:500;}
  .social-row{display:flex;gap:12px;margin-top:34px;}
  .social-row a{
    width:38px;height:38px;border:1px solid rgba(255,255,255,0.25);
    border-radius:2px;display:flex;align-items:center;justify-content:center;
    transition:background .15s ease, border-color .15s ease;
  }
  .social-row a:hover{background:var(--azul-claro-2);border-color:var(--azul-claro-2);}
  .social-row svg{width:17px;height:17px;color:#fff;}

  .contato-form{background:#fff;padding:52px 44px;}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  .field{margin-bottom:20px;}
  .field label{
    display:block;font-size:0.82rem;font-weight:600;color:var(--azul-profundo);margin-bottom:8px;
  }
  .field input, .field select, .field textarea{
    width:100%;padding:13px 14px;
    border:1.5px solid var(--cinza-borda);
    border-radius:var(--radius);
    font-size:0.95rem;color:var(--cinza-escuro);
    transition:border-color .15s ease, box-shadow .15s ease;
    background:#fff;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none;border-color:var(--azul-claro-2);
    box-shadow:0 0 0 3px rgba(61,125,201,0.14);
  }
  .field textarea{resize:vertical;min-height:100px;}
  .nr-hint{font-size:0.82rem;color:var(--cinza-suave);margin-bottom:12px;line-height:1.4;}
  .nr-chips{display:flex;flex-wrap:wrap;gap:8px;}
  .nr-chip{
    position:relative;
    display:inline-flex;align-items:center;
    padding:8px 12px;
    border:1.5px solid var(--cinza-borda);
    border-radius:20px;
    font-family:var(--mono);
    font-size:0.76rem;
    color:var(--cinza-medio);
    cursor:pointer;
    transition:background .15s ease, border-color .15s ease, color .15s ease;
    user-select:none;
  }
  .nr-chip input{
    position:absolute;opacity:0;width:1px;height:1px;
  }
  .nr-chip:hover{border-color:var(--azul-claro-2);}
  .nr-chip.checked{
    background:var(--azul-claro-2);
    border-color:var(--azul-claro-2);
    color:#fff;
  }
  .nr-chip input:focus-visible ~ span{
    outline:2px solid var(--azul-claro-2);outline-offset:3px;border-radius:2px;
  }
  .form-note{font-size:0.82rem;color:var(--cinza-suave);margin-top:6px;}
  .form-success{
    display:none;
    align-items:center;gap:12px;
    background:var(--azul-vidro);
    border:1px solid var(--azul-claro);
    color:var(--azul-profundo);
    padding:16px 18px;border-radius:var(--radius);
    font-size:0.92rem;font-weight:500;
    margin-top:6px;
  }
  .form-success svg{width:20px;height:20px;color:var(--azul-claro-2);flex-shrink:0;}

  /* ---------- FOOTER ---------- */
  footer{background:var(--azul-profundo-2);color:#9DB0C2;padding:64px 0 28px;}
  .footer-top{
    display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;
    padding-bottom:44px;border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .footer-brand .logo{color:#fff;margin-bottom:14px;}
  .footer-brand .logo-mark{border-color:#fff;}
  .footer-brand p{font-size:0.9rem;line-height:1.6;max-width:280px;color:#8298AC;}
  .footer-col h4{
    font-family:var(--mono);font-size:0.74rem;letter-spacing:0.08em;text-transform:uppercase;
    color:#fff;margin-bottom:18px;font-weight:600;
  }
  .footer-col ul li{margin-bottom:11px;}
  .footer-col a{font-size:0.9rem;color:#8298AC;transition:color .15s ease;}
  .footer-col a:hover{color:var(--azul-claro);}
  .footer-bottom{
    display:flex;justify-content:space-between;align-items:center;
    padding-top:26px;font-size:0.82rem;color:#63768A;flex-wrap:wrap;gap:12px;
  }
  .footer-bottom a{color:#8298AC;}
  .footer-bottom a:hover{color:var(--azul-claro);}
  .footer-legal{display:flex;gap:22px;flex-wrap:wrap;}

  /* ---------- reveal on scroll ---------- */
  .reveal{opacity:0;transform:translateY(22px);transition:opacity .6s ease, transform .6s ease;}
  .reveal.in{opacity:1;transform:translateY(0);}

  /* ---------- FOCUS VISIBLE ---------- */
  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible{
    outline:2px solid var(--azul-claro-2);outline-offset:2px;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 980px){
    .hero .wrap{grid-template-columns:1fr;}
    .hero-visual{order:-1;max-width:420px;margin:0 auto;}
    .sobre{grid-template-columns:1fr;}
    .servicos-grid{grid-template-columns:1fr 1fr;}
    .dif-grid{grid-template-columns:1fr 1fr;}
    .contato-grid{grid-template-columns:1fr;}
    .footer-top{grid-template-columns:1fr 1fr;}
  }
  @media (max-width: 720px){
    .wrap{padding:0 20px;}
    .nav-links{
      position:fixed;top:78px;left:0;right:0;bottom:0;
      background:#fff;flex-direction:column;align-items:flex-start;
      padding:28px 24px;gap:22px;
      transform:translateX(100%);transition:transform .25s ease;
      border-top:1px solid var(--cinza-borda);
    }
    .nav-links.open{transform:translateX(0);}
    .nav-right .btn-primary{padding:10px 16px;font-size:0.86rem;}
    .burger{display:flex;}
    .hero{padding:56px 0 64px;}
    .hero-ctas{flex-direction:column;align-items:stretch;}
    section{padding:68px 0;}
    .servicos-grid{grid-template-columns:1fr;}
    .dif-grid{grid-template-columns:1fr;}
    .form-row{grid-template-columns:1fr;}
    .contato-info, .contato-form{padding:36px 26px;}
    .footer-top{grid-template-columns:1fr;gap:32px;}
    .footer-bottom{flex-direction:column;align-items:flex-start;}
    .compliance-bar{gap:10px;}
  }
</style>
</head>
<body>

<!-- ================= HEADER ================= -->
<header>
  <nav class="wrap nav">
    <a href="#inicio" class="logo">
      <span class="logo-mark"></span>
      Wagner<span class="dot"></span>
    </a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#inicio">Início</a></li>
      <li><a href="#sobre">Sobre Nós</a></li>
      <li><a href="#servicos">Serviços</a></li>
      <li><a href="#diferenciais">Diferenciais</a></li>
      <li><a href="#contato">Contato</a></li>
    </ul>
    <div class="nav-right">
